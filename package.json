{
  "name": "nim-ramp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/machine && tsc --noEmit -p packages/rails && tsc --noEmit -p packages/wallet && tsc --noEmit -p packages/receipt && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "dev:api": "pnpm --filter @ramp/api dev",
    "dev:web": "pnpm --filter @ramp/web dev",
    "test:live": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run packages/rails/test/live.integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "viem": "^2.56.3",
    "vitest": "^2.1.0"
  }
}
