# nimRamp — configuration surface.
# Copy to .env and fill. .env is gitignored and never committed: the
# competition rules forbid hardcoded credentials and these are live rails keys.

# --- Rails (our own client, written fresh for this repo — see brief §7) ---
RAILS_API_BASE=
RAILS_API_KEY=
RAILS_WEBHOOK_SECRET=

# --- Corridors. NGN, KES, TZS, UGX — Paycrest does not serve GHS.
# Off by default; a corridor goes live only when its rail is
# clean. This is the release valve in brief §6 — three can go dark and we
# still ship a complete product in one.
CORRIDOR_NGN_ENABLED=false
CORRIDOR_KES_ENABLED=false
CORRIDOR_UGX_ENABLED=false
CORRIDOR_TZS_ENABLED=false

# --- Settlement: USDT on Polygon ---
POLYGON_RPC_URL=
USDT_POLYGON_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
TREASURY_ADDRESS=

# --- Gas seeding for cash-out ---
# A wallet paid by a cash-in holds stablecoin and no native token, so sending
# it back out is unaffordable. With a key here the server covers the fee
# itself — about two cents on Polygon, once per order, only ever to the
# address that owns that order. Leave it blank and cash-out still works for
# anyone already holding gas; they just see the shortfall explained instead.
#
# Fund this wallet, do not reuse a personal one, and keep the balance small.
GAS_FUNDER_KEY=
# Optional per-chain RPCs. Unset falls back to viem's public endpoints, which
# is fine for a faucet sending cents and worth replacing for anything busier.
BASE_RPC_URL=
ARBITRUM_ONE_RPC_URL=
ETHEREUM_RPC_URL=
BNB_SMART_CHAIN_RPC_URL=
# Where the gas payouts are logged (append-only JSONL). One drip per order is
# enforced from this file, so losing it re-arms the faucet.
DRIPS_PATH=.nimramp/drips.jsonl

# --- On-chain receipt (Nimiq L1, feeless; brief §7) ---
NIMIQ_RPC_URL=
NIMIQ_RECEIPT_ADDRESS=
RECEIPTS_ENABLED=false

# --- Safety rails for the competition period (brief §7, non-negotiable) ---
# Per-transaction ceiling, in whole USDT. A stuck transaction in front of a
# judge costs more than any feature is worth.
MAX_TX_USDT=50
# Flip to true to refuse every new quote. Must be togglable from a phone.
KILL_SWITCH=false

# Where the order log lives (append-only JSONL).
ORDERS_PATH=.nimramp/orders.jsonl
# Origin allowed to call the API in development (the tunnel URL).
WEB_ORIGIN=*
PORT=8788
